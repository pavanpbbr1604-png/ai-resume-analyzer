# AI Resume Analyzer Environment Configuration
# Copy this file to .env in the backend folder and fill in your API keys

# Preferred cheap / free AI Provider: 'auto', 'gemini', 'openai', or 'mock'
AI_PROVIDER=auto

# Google Gemini API Key (100% Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=
# Gemini Model: gemini-2.0-flash (fastest & cheapest/free) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key (Optional fallback, e.g., gpt-4o-mini)
OPENAI_API_KEY=
